import java.util.*;
class DuplicateRemove{
    public static void main(String[]args)
    {
        int arr[]={1,2,3,3,4};
 
        HashSet<Integer>set=new HashSet<>();
        for(int i=0;i<arr.length;i++)
        {
            
          set.add(arr[i]);
        }
        System.out.println("after remove duplicate ");
        for(int num:set)
        {
            System.out.println(num);
        }
    }
}
